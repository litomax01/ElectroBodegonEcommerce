# Copia este archivo como ".env" (ignorado por git) y completa los valores.
# En Vercel / Netlify se definen como variables de entorno del proyecto.
#
# Supabase → Project Settings → API / API Keys
# Usa SOLO la clave pública: "anon" o "sb_publishable_...".
# NUNCA pongas aquí la "service_role" ni una "sb_secret_...": el build fallará.

SUPABASE_URL=
SUPABASE_ANON_KEY=
