# Copia este archivo como ".env" (ignorado por git) y completa los valores.
# En Vercel / Netlify / Render se definen como variables de entorno del proyecto.
#
# Supabase → Project Settings → API Keys
# Usa SOLO la clave pública "sb_publishable_...".
# NUNCA pongas aquí una "sb_secret_..." ni la "service_role": el build fallará.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Alternativa heredada (solo si el proyecto usa claves JWT antiguas):
# SUPABASE_ANON_KEY=

# --- Sitio (opcionales; vacío = desactivado) ---
# Origen público definitivo, sin barra final ni ruta. Se usa en canonical, Open Graph,
# datos estructurados y sitemap. Mientras esté vacío se usa el dominio de la petición.
SITE_URL=

# Analítica: déjalas vacías hasta que el cliente entregue los identificadores.
# Con valor vacío NO se carga ningún script de seguimiento.
GA4_MEASUREMENT_ID=
META_PIXEL_ID=

# --- Solo en tiempo de ejecución del servidor SSR (no las lee el build) ---
# Dominios desde los que se acepta tráfico, separados por comas. Admite comodines (*.vercel.app).
# NG_ALLOWED_HOSTS=electrobodegon.com,www.electrobodegon.com
