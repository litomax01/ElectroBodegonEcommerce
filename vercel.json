{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/ElectroBodegon/browser",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/ElectroBodegon/server/**",
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/(.*)\\.(js|css|woff2)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(favicon.ico|logo.png)",
      "headers": { "Cache-Control": "public, max-age=86400" },
      "continue": true
    },
    { "src": "^/$", "dest": "/api/index" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index" }
  ]
}
